{
  "permissions": {
    "allow": [
      "Bash(npm run *)", "Bash(npm test *)", "Bash(./scripts/*)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git checkout -b *)",
      "Edit", "Write"
    ],
    "deny": [
      "Bash(git push *)", "Bash(rm -rf*)", "Bash(curl *)", "Bash(wget *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/state-summary.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/autoformat.sh" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [
          { "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/bash-guard.sh" },
          { "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/commit-gate.sh" }
        ] }
    ]
  }
}
