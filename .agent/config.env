# Statische Orchestrierungsgrenzen. Diese Datei niemals mit source/eval laden.
MAX_GLOBAL_ITERATIONS=10
MAX_TASK_ATTEMPTS=3
MAX_NO_PROGRESS=1
CONTEXT_MAX_CHARS=48000
NOTES_MAX_CHARS=12000
VERIFY_TIMEOUT_SECONDS=90
AGENT_TIMEOUT_SECONDS=900
AGENT_MAX_TURNS=60
MAX_INFRA_RETRIES=1
RETRY_BACKOFF_SECONDS=1
# claude oder codex. Beide liefern denselben Ergebnisvertrag, aber
# unterschiedliche Sicherheitshuellen (siehe docs/ARCHITECTURE.md).
AGENT_RUNNER=claude
# default ueberlaesst die Modellwahl dem gewaehlten CLI.
AGENT_MODEL=default
FINALIZER=off
